# =================================================================
# FindBack AI Enterprise - Backend Environment Configuration
# =================================================================

# Server Port (Render automatically sets PORT in production)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=production

# Custom Database File Storage Path (Optional, defaults to ./local_db.json)
# DB_FILE_PATH=/var/data/local_db.json

# CORS & Frontend Origins (Optional, default allows all origins)
FRONTEND_URL=https://findback-ai.onrender.com

# SMTP Nodemailer Email Configuration (Optional - for real email OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
