# ==============================================================================
# FindBack AI Enterprise - Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Port (Render / Cloud hosts automatically assign PORT in production)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=production

# PostgreSQL Database Connection String (Supabase / Render / Neon / AWS RDS)
DATABASE_URL=postgresql://db_user:your_secure_password@db_host:5432/findback_enterprise?sslmode=require

# SQL Query Debug Logging (true | false)
DEBUG_SQL=false

# Custom Database File Storage Fallback Path (Optional, defaults to ./local_db.json)
DB_FILE_PATH=./local_db.json

# CORS & Frontend Origins (Allowed client domains for API access)
FRONTEND_URL=https://findback-ai.onrender.com

# SMTP Nodemailer Email Configuration (For live 6-digit OTP dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Alternative Gmail Environment Keys (Fallback aliases for SMTP credentials)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_gmail_app_password

# Diagnostic & Test Target Email
TEST_EMAIL=test.diagnostics@example.com
