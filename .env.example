# ==============================================================================
# FindBack AI Enterprise - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` or `.env.local` and populate the values.
# DO NOT commit real secrets, private keys, or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Node.js Express Backend)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Path to file-backed JSON/SQLite database storage fallback
DB_FILE_PATH=./local_db.json

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Connection string for production PostgreSQL database
DATABASE_URL=postgresql://db_user:your_secure_password@db_host:5432/findback_enterprise?sslmode=require

# Enable verbose SQL execution query logging (true | false)
DEBUG_SQL=false

# ------------------------------------------------------------------------------
# 3. SMTP & EMAIL OTP SERVICE (Nodemailer / Gmail / SendGrid / AWS SES)
# ------------------------------------------------------------------------------
# Outbound SMTP host and port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Primary SMTP authentication credentials
SMTP_USER=your_verified_sender_email@gmail.com
SMTP_PASS=your_16_character_app_password

# Alternative Gmail service keys (fallback for SMTP_USER / SMTP_PASS)
GMAIL_USER=your_verified_sender_email@gmail.com
GMAIL_APP_PASS=your_16_character_app_password

# ------------------------------------------------------------------------------
# 4. FRONTEND APPLICATION (Vite / React Client)
# ------------------------------------------------------------------------------
# Primary API endpoint consumed by the web client
VITE_API_BASE_URL=https://findback-ai-backend.onrender.com/api

# Backend server root URL (used for healthchecks and static assets)
VITE_BACKEND_URL=https://findback-ai-backend.onrender.com

# Public web frontend URL (used in email links, QR codes & redirects)
VITE_FRONTEND_URL=https://findback-ai.onrender.com

# Development authentication bypass flag (set to 'false' in production)
VITE_DEV_BYPASS_AUTH=false

# ------------------------------------------------------------------------------
# 5. BASE44 CLOUD PLATFORM CONFIGURATION (Optional / Managed Backend)
# ------------------------------------------------------------------------------
VITE_BASE44_APP_ID=your_base44_app_id_here
VITE_BASE44_APP_BASE_URL=https://api.base44.com
VITE_BASE44_FUNCTIONS_VERSION=v1
BASE44_LEGACY_SDK_IMPORTS=false

# ------------------------------------------------------------------------------
# 6. TESTING & DIAGNOSTICS
# ------------------------------------------------------------------------------
# Target email recipient for live SMTP diagnostic test suites
TEST_EMAIL=test.diagnostics@example.com
