{
  "name": "User",
  "type": "object",
  "properties": {
    "password": {
      "type": "string",
      "default": "Zero@123"
    },
    "security_key": {
      "type": "string",
      "default": "SEC123"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "phone": {
      "type": "string"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "disallowed_fields": ["role", "account_status"]
        }
      ]
    },
    "admin_update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}