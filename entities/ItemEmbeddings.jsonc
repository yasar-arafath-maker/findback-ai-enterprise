{
  "name": "ItemEmbeddings",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": ["lost", "found"]
    },
    "phash": {
      "type": "string"
    },
    "structural_hash": {
      "type": "string"
    },
    "spatial_cell_h3": {
      "type": "string"
    },
    "color_vector": {
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "report_type",
    "phash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      },
      "_comment": "Embedding data is internal infrastructure used only by service-role matching routines. Regular users should never read raw hashes or vectors."
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
