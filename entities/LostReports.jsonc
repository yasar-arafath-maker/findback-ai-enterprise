{
  "name": "LostReports",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Electronics",
        "Bags",
        "Documents",
        "Jewelry",
        "Keys",
        "Pets",
        "Clothing",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "distinguishing_marks": {
      "type": "string"
    },
    "location_text": {
      "type": "string"
    },
    "location_lat": {
      "type": "number"
    },
    "location_lng": {
      "type": "number"
    },
    "lost_date": {
      "type": "string",
      "format": "date"
    },
    "lost_time": {
      "type": "string"
    },
    "primary_image_url": {
      "type": "string"
    },
    "storage_location": {
      "type": "string"
    },
    "owner_response_status": {
      "type": "string",
      "enum": [
        "awaiting_response",
        "notified",
        "responded_claimed",
        "responded_rejected",
        "retention_extended",
        "expired_unclaimed"
      ],
      "default": "awaiting_response"
    },
    "owner_notified_at": {
      "type": "string"
    },
    "owner_response_deadline": {
      "type": "string"
    },
    "retention_until": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "matched",
        "claim_pending",
        "closed",
        "duplicate",
        "expired_unclaimed"
      ],
      "default": "active"
    },
    "is_duplicate_of": {
      "type": "string"
    }
  },
  "required": [
    "reporter_id",
    "title",
    "category",
    "description",
    "location_text",
    "lost_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.reporter_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.status": "active"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}